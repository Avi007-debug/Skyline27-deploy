generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id            String         @id
  fullName      String         @map("full_name")
  email         String         @unique(map: "profile_email_key")
  password      String?
  usn           String?        @unique(map: "profile_usn_key")
  branch        String?
  phone         String?
  year          Int?
  sem           Int?
  clubId        String?        @map("club_id")
  role          Role           @default(MEMBER)
  club          Club?          @relation(fields: [clubId], references: [id], map: "fk_profile_club")
  registrations Registration[]
  expenses      ExpenseClaim[] @relation("ClaimantExpenses")
  approvedClaims ExpenseClaim[] @relation("ApproverExpenses")
  auditLogs     AuditLog[]

  @@index([clubId], map: "idx_profile_club")
}

model Club {
  id               String            @id @default(uuid())
  name             String
  email            String            @unique(map: "club_email_key")
  logoUrl          String?           @map("logo_url") @db.Text
  password         String?
  qrUrl            String?           @map("qr_url") @db.Text
  upiId            String?           @map("upi_id")
  events           Event[]
  admins           Profile[]
  registrationKeys RegistrationKey[]
}

model Event {
  id                   String         @id @default(uuid())
  clubId               String         @map("club_id")
  name                 String
  description          String         @db.Text
  eventType            String         @map("event_type")
  fee                  Float          @default(0)
  registrationLimit    Int            @map("registration_limit")
  registrationDeadline DateTime       @map("registration_deadline")
  eventDate            DateTime       @map("event_date")
  qrUrl                String?        @map("qr_url") @db.Text
  bannerUrl            String?        @map("banner_url") @db.Text
  venue                String?
  teamSizeLimit        Int?           @map("team_size_limit")
  minTeamSize          Int?           @map("min_team_size")
  eventEndDate         DateTime?      @map("event_end_date")
  upiId                String?        @map("upi_id")
  club                 Club           @relation(fields: [clubId], references: [id], onDelete: Cascade, map: "fk_event_club")
  notifications        Notification[]
  registrations        Registration[]
  teams                Team[]

  @@index([clubId], map: "idx_event_club")
}

model Team {
  id            String         @id @default(uuid())
  eventId       String         @map("event_id")
  teamName      String         @map("team_name")
  passkey       String?        @unique(map: "team_passkey_key")
  leaderId      String         @map("leader_id")
  registrations Registration[]
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade, map: "fk_team_event")

  @@index([eventId], map: "idx_team_event")
}

model Registration {
  id              String             @id @default(uuid())
  eventId         String             @map("event_id")
  userId          String             @map("user_id")
  teamId          String?            @map("team_id")
  paymentProofUrl String?            @map("payment_proof_url") @db.Text
  status          RegistrationStatus @default(PENDING)
  createdAt       DateTime           @default(now()) @map("created_at")
  transactionId   String?            @map("transaction_id")
  checkedInAt     DateTime?          @map("checked_in_at")
  event           Event              @relation(fields: [eventId], references: [id], onDelete: Cascade, map: "fk_registration_event")
  profile         Profile            @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_registration_profile")
  team            Team?              @relation(fields: [teamId], references: [id], onDelete: Cascade, map: "fk_registration_team")

  @@unique([eventId, userId], map: "unique_event_user_registration")
  @@index([eventId], map: "idx_registration_event")
  @@index([userId], map: "idx_registration_profile")
  @@index([teamId], map: "idx_registration_team")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  title     String
  body      String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  eventId   String?  @map("event_id")
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade, map: "fk_notification_event")

  @@index([eventId], map: "idx_notification_event")
}

model RegistrationKey {
  id           String    @id @default(uuid())
  code         String    @unique(map: "registrationkey_code_key")
  isUsed       Boolean   @default(false) @map("is_used")
  usedByClubId String?   @map("used_by_club_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  usedAt       DateTime? @map("used_at")
  usedByClub   Club?     @relation(fields: [usedByClubId], references: [id], map: "fk_registrationkey_club")

  @@index([usedByClubId], map: "idx_registrationkey_club")
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum Role {
  MEMBER
  VOLUNTEER
  TREASURER
  ADMIN
}

enum LedgerType {
  IN
  OUT
}

model LedgerEntry {
  id          Int        @id @default(autoincrement())
  clubId      String?    @map("club_id")
  type        LedgerType
  category    String
  amountPaise Int        @map("amount_paise")
  refType     String     @map("ref_type")
  refId       String     @map("ref_id")
  eventId     String?    @map("event_id")
  projectId   String?    @map("project_id")
  memo        String?
  actorId     String?    @map("actor_id")
  reversesId  Int?       @map("reverses_id")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  prevHash    String     @map("prev_hash") @db.Char(64)
  hash        String     @unique @db.Char(64)

  @@unique([refType, refId, type], map: "unique_ledger_ref")
  @@index([category], map: "idx_ledger_category")
  @@index([eventId], map: "idx_ledger_event")
  @@index([clubId], map: "idx_ledger_club")
}

model LedgerHead {
  id       Int    @id
  lastHash String @map("last_hash") @db.Char(64)
}

enum ExpenseStatus {
  SUBMITTED
  APPROVED
  REJECTED
  REIMBURSED
}

model ExpenseClaim {
  id            String        @id @default(uuid())
  clubId        String?       @map("club_id")
  claimantId    String        @map("claimant_id")
  title         String
  vendor        String?
  amountPaise   Int           @map("amount_paise")
  category      String        @default("EXPENSE")
  eventId       String?       @map("event_id")
  projectId     String?       @map("project_id")
  dateSpent     DateTime      @default(now()) @map("date_spent")
  receiptUrl    String        @map("receipt_url") @db.Text
  scannedAmount Int?          @map("scanned_amount")
  mismatchFlag  Boolean       @default(false) @map("mismatch_flag")
  status        ExpenseStatus @default(SUBMITTED)
  approverId    String?       @map("approver_id")
  decisionNote  String?       @map("decision_note") @db.Text
  reimbursedAt  DateTime?     @map("reimbursed_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  claimant Profile  @relation("ClaimantExpenses", fields: [claimantId], references: [id], onDelete: Cascade)
  approver Profile? @relation("ApproverExpenses", fields: [approverId], references: [id])

  @@index([claimantId], map: "idx_expense_claimant")
  @@index([status], map: "idx_expense_status")
  @@index([clubId], map: "idx_expense_club")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  details    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  actor Profile? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId], map: "idx_audit_entity")
  @@index([actorId], map: "idx_audit_actor")
}

