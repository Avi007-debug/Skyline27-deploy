# PostgreSQL Connection String (Supabase or Local PostgreSQL)
# Option A: Supabase (Pooler / Transaction Mode - Port 6543)
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Option B: Supabase (Direct Connection - Port 5432)
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Option C: Local PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/skyline_db?schema=public"

# Optional direct connection URL for migrations when using poolers
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

PORT=5000
JWT_SECRET="skyline_secure_jwt_secret_key"
ADMIN_SECRET="skyline_admin_secret_key"
GOOGLE_CLIENT_ID="614014299614-n10khe2om4g50ehpqb6h82tdtumkh5ot.apps.googleusercontent.com"

# Supabase Storage (used for image/file uploads)
SUPABASE_URL="https://flmxldwdbqbyrokmglus.supabase.co"
