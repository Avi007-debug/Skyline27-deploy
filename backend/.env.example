# ===================================================
# SkylineOS Backend Environment Configuration Example
# ===================================================

PORT=5000
JWT_SECRET="skyline_secure_jwt_secret_key"
GOOGLE_CLIENT_ID="your_google_client_id"

# ---------------------------------------------------
# DATABASE MODE TOGGLE: "local" or "supabase"
# ---------------------------------------------------
DB_MODE="local"

# ---------------------------------------------------
# 1. LOCAL POSTGRESQL (Database: Skyline-local)
# ---------------------------------------------------
LOCAL_DATABASE_URL="postgresql://postgres:[LOCAL-PASSWORD]@localhost:5432/Skyline-local?schema=public"

# ---------------------------------------------------
# 2. SUPABASE POSTGRESQL
# ---------------------------------------------------
SUPABASE_DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
SUPABASE_DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# Default fallback
DATABASE_URL="postgresql://postgres:[LOCAL-PASSWORD]@localhost:5432/Skyline-local?schema=public"

# ---------------------------------------------------
# SUPABASE STORAGE & SERVICES
# ---------------------------------------------------
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
UPLOAD_SECRET="your_upload_secret"
SUPABASE_STORAGE_BUCKET="skyline-images"

# ---------------------------------------------------
# AUTH, EMAIL & APP URLS
# ---------------------------------------------------
# Required in production (the server refuses to start with the dev fallback).
# JWT_SECRET must be a long random string.
# Create the first Super Admin with:
#   ADMIN_EMAIL=you@example.com ADMIN_PASSWORD='S3cure-pass1' npm run admin:create
CORS_ORIGINS="https://skyline.example.com"
# The single website (students, club heads and admins all use it). Used in emailed links.
SITE_URL="http://localhost:5173"

# Password-reset email (SMTP). Without it, links are only logged in development.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SkylineOS <no-reply@example.com>"

# Event times are floating campus wall-clock values. Minutes the campus clock is
# ahead of UTC (330 for India) so deadlines/"live" status are exact on campus.
CAMPUS_UTC_OFFSET_MINUTES="0"

# Shared secret for the scheduler that calls POST /api/notifications/event-reminders
CRON_SECRET=""

# Private bucket for expense receipts (create it as NON-public in Supabase)
SUPABASE_PRIVATE_BUCKET="skyline-private"
